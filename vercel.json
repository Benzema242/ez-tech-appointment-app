{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "crons": [
    {
      "path": "/api/subscription-cron",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/appointment-reminder-cron",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/weekly-digest",
      "schedule": "0 13 * * 1"
    }
  ]
}
